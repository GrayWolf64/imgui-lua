{
    "diagnostics.disable": [
        "need-check-nil",
        "undefined-field",
        "inject-field",
        "lowercase-global",
        "cast-local-type",
        "param-type-mismatch",
        "assign-type-mismatch",
        "return-type-mismatch"
    ],
    "checkThirdParty": false,
    "runtime.special": {
        "include": "dofile",
        "IncludeCS": "dofile"
    },
    "runtime.nonstandardSymbol": [
        "continue"
    ],
    "workspace.library": [
        "${addons}/garrysmod/module/library"
    ],
    "diagnostics.ignoredFiles": "Disable",
    "workspace.ignoreDir": [
        "/lua/backends/"
    ],
    "workspace.maxPreload": 1024,
    "workspace.preloadFileSize": 2048,
    "runtime.version": "LuaJIT"
}